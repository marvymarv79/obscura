{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/watchlist-alert",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/vigilia/digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/vigilia/stale-check",
      "schedule": "0 10 * * *"
    }
  ]
}
